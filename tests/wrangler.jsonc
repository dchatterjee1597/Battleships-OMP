{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "battleships-omp-v1-test",
  "main": "../src/server/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "BattleshipsRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BattleshipsRoom"] }],
  "vars": {
    "INVITE_TOKEN": "local-test-invite-not-for-production-1234",
    "ADMIN_PASSPHRASE": "local-test-admin-not-for-production",
  },
}
