{
  "name": "battleships-omp-v1",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src tests scripts *.json *.jsonc *.ts *.md index.html",
    "format:check": "prettier --check src tests scripts *.json *.jsonc *.ts *.md index.html",
    "setup": "node scripts/setup.mjs",
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:ui": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/run-e2e.mjs",
    "test:persistence": "npm run build && node tests/persistence.mjs",
    "build": "vite build",
    "types": "wrangler types worker-configuration.d.ts",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e && npm run test:persistence && npm run test:runtime",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "test:server": "npm run build && wrangler dev --config tests/wrangler.jsonc --port 8788 --persist-to .wrangler/test-state",
    "test:runtime": "npm run build && node tests/community-runtime.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0",
    "ws": "8.21.0"
  }
}
